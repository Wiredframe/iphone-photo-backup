#!/bin/bash
# Backs up photos and videos taken with the iPhone camera (USB or Wi-Fi) to another machine via SSH.
# Runs the Python script with the interpreter of the pipx venv of pymobiledevice3.
set -euo pipefail
here="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
py="${PIPX_HOME:-$HOME/Library/Application Support/pipx}/venvs/pymobiledevice3/bin/python"
[[ -x "$py" ]] || py="$HOME/.local/pipx/venvs/pymobiledevice3/bin/python"
if [[ ! -x "$py" ]]; then
  echo "pymobiledevice3 is missing: pipx install pymobiledevice3" >&2
  exit 1
fi
exec "$py" -I "$here/iphone_photo_backup.py" "$@"
